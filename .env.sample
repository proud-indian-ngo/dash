# Database
DEV_DB_HOST="localhost:5432"
DEV_DB_PASSWORD=""
DATABASE_URL="postgres://postgres:${DEV_DB_PASSWORD}@${DEV_DB_HOST}/pi-dash"

# Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001  # usually same as BETTER_AUTH_URL
COOKIE_DOMAIN=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Finance-private fields (donor PAN, bank numbers). Base64 of 32 random bytes: `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=""

# Zero Cache (consumed by zero-cache process directly)
ZERO_APP_PUBLICATIONS=pi_dash_public
ZERO_UPSTREAM_DB="${DATABASE_URL}"
ZERO_ADMIN_PASSWORD=""
ZERO_OPERATOR_PASSWORD=""
ZERO_MUTATE_FORWARD_COOKIES="true"
ZERO_MUTATE_URL="http://localhost:3001/api/zero/mutate"
ZERO_QUERY_FORWARD_COOKIES="true"
ZERO_QUERY_URL="http://localhost:3001/api/zero/query"
ZERO_LOG_LEVEL="info"
ZERO_QUERY_HYDRATION_STATS="false"
ZERO_REPLICA_FILE="/tmp/zero.db"

# Client (VITE_* — exposed to browser)
VITE_ZERO_URL="http://localhost:4848"
VITE_CDN_URL=""
VITE_IMMICH_URL=""

# Email (Resend) — leave empty in dev to skip sending (auth links are logged)
RESEND_API_KEY=""
EMAIL_FROM=""  # address on a domain verified in Resend, or "Name <address>"
RESEND_WEBHOOK_SECRET=""  # whsec_… from the Resend webhook for bounces/complaints

# Avatars
GRAVATAR_API_KEY=""
AVATAR_FALLBACK_SEED=""
GRAVATAR_API_BASE_URL="https://api.gravatar.com/v3"  # optional override
GRAVATAR_TIMEOUT_MS="5000"  # optional timeout (ms)

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="pi-dash"
R2_KEY_PREFIX="attachments"

# App
APP_NAME="Proud Indian Dashboard"
APP_URL=""

# Public website (optional): fine-grained GitHub token for proud-indian-ngo/website
# (Contents: read and write). When set, a 5-minute job sends the website's
# `events-changed` repository_dispatch whenever /api/public/events changes.
# Keep the real token out of the repo; it lets anyone trigger builds.
WEBSITE_DISPATCH_TOKEN=""

# Notifications (optional)
WHATSAPP_API_URL=""
WHATSAPP_AUTH_USER="admin"
WHATSAPP_AUTH_PASS="admin"
WHATSAPP_WEBHOOK_SECRET=""  # required for WhatsApp webhook validation
# WhatsApp Cloud API (official). Token + phone number ID switch messages to
# people from GoWA to Meta templates; see DEPLOYMENT.md.
WHATSAPP_CLOUD_ACCESS_TOKEN=""  # system user token, never expires
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=""
WHATSAPP_CLOUD_APP_SECRET=""  # verifies /api/whatsapp/cloud/webhook
WHATSAPP_CLOUD_VERIFY_TOKEN=""  # any random string, also entered in Meta's webhook form
WHATSAPP_CLOUD_GRAPH_VERSION=""  # default v25.0

# Razorpay Payment Page donations (optional). Ingestion is on only when both
# RAZORPAY_KEY_ID and RAZORPAY_WEBHOOK_SECRET are set; the key id's prefix
# (rzp_live_ / rzp_test_) decides live or test mode. RAZORPAY_KEY_SECRET is
# optional: with it each payment is fetched from the Razorpay API, without it
# the signed webhook copy is used. Keep real values out of the repo.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Photos / Immich (optional)
IMMICH_API_KEY=""

# Social API (optional): HMAC key (32+ chars) for the signed photo links returned by
# /api/social/v1/events/{id}/photos. Unset disables the photo endpoints (503).
# Generate with: openssl rand -hex 32
SOCIAL_MEDIA_SIGNING_SECRET=""

# Governance signing service (optional): services/signing, reached over the private network.
# Unset stores signed PDFs in the vault without a signature check.
# Generate the token with: openssl rand -hex 32 (the service gets the same value)
SIGNING_SERVICE_URL=""
SIGNING_SERVICE_TOKEN=""

# Photo notifications — seconds to wait before sending approval/rejection
# notifications (batches photos approved in the same window). Default: 120.
# Set to 5 in E2E test environments.
PHOTO_NOTIFICATION_DELAY_SECONDS=120

# Observability (optional)
APP_ENV="development"
VITE_APP_ENV="development"
POSTHOG_API_KEY=""
VITE_POSTHOG_KEY=""
POSTHOG_CLI_API_KEY=""  # prod Compose build secret; uploads source maps
POSTHOG_CLI_PROJECT_ID=""
ZERO_OTEL_LOGS_EXPORTER="none"  # prod Compose only; otlp to export zero-cache logs
ZERO_OTEL_METRICS_EXPORTER="none"  # prod Compose only; otlp to export zero-cache metrics

# Cash voucher (required)
VOUCHER_ORG_NAME=""
VOUCHER_ORG_ADDRESS=""
VOUCHER_ORG_PHONE=""
VOUCHER_ORG_EMAIL=""
VOUCHER_ORG_REGISTRATION=""
VOUCHER_FINANCE_ADMIN_NAME=""

# Client (VITE_* — additional)
VITE_APP_NAME="Proud Indian Dashboard"
