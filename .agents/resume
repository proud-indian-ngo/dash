#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

bun_version="$(sed -n 's/.*"packageManager": "bun@\([^"]*\)".*/\1/p' package.json)"
bun_bin="$HOME/.bun/bin/bun"

if [[ ! -x "$bun_bin" ]] || [[ "$($bun_bin --version)" != "$bun_version" ]]; then
  echo "Pinned Bun ${bun_version} is unavailable; rerun .agents/setup" >&2
  exit 1
fi

if ! sudo pg_ctlcluster 18 main status >/dev/null 2>&1; then
  sudo pg_ctlcluster 18 main start
fi

if ! pg_isready -h localhost -p 5432 -q; then
  echo "PostgreSQL is not ready on localhost:5432" >&2
  exit 1
fi

echo "Orb ready (Bun ${bun_version}, PostgreSQL 18)."
