{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tags": ["-lintignore"],
  "ignoreDependencies": ["@commitlint/cli", "uuidv7"],
  "ignoreIssues": {
    "src/generated/**": ["exports", "types"],
    "**/*.generated.ts": ["exports", "types"],
    "packages/design-system/components/**": ["exports", "types"],
    "packages/editor/components/**": ["exports", "types", "unlisted"],
    "packages/zero/src/schema.ts": ["duplicates", "exports", "types"],
    "packages/db/src/schema/auth.ts": ["exports", "types"],
    "packages/shared/src/constants.ts": ["types"],
    "packages/shared/src/event-reminders.ts": ["types"]
  },
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {},
    "apps/web": {
      "entry": ["scripts/profile-entry-eligibility.ts"],
      "ignoreFiles": ["src/entry-server.ts", "server/**", "src/stubs/**"]
    },
    "packages/db": {
      "ignoreFiles": ["scripts/**"]
    },
    "packages/e2e": {
      "ignoreFiles": ["global-setup.ts"],
      "entry": [
        "helpers/kalakriti-attendee-subject.ts",
        "helpers/kalakriti-centers.ts",
        "helpers/kalakriti-transport.ts",
        "helpers/kalakriti-inventory.ts",
        "helpers/kalakriti-event-day-transport.ts",
        "helpers/kalakriti-station-subject.ts",
        "helpers/kalakriti-person-qr.ts",
        "helpers/kalakriti-operations.ts",
        "helpers/kalakriti-competitions.ts",
        "helpers/kalakriti-edition-creation.ts",
        "helpers/kalakriti-entries.ts",
        "helpers/kalakriti-eligibility.ts",
        "helpers/kalakriti-guardian-invite.ts",
        "helpers/kalakriti-guardian-race.ts",
        "helpers/kalakriti-lifecycle.ts",
        "helpers/kalakriti-public-schedule.ts",
        "helpers/kalakriti-release-races.ts",
        "helpers/kalakriti-results.ts",
        "helpers/kalakriti-students.ts",
        "helpers/kalakriti-volunteer-assignment.ts",
        "helpers/register-url-options.ts",
        "helpers/role-dashboard-fixture.ts",
        "helpers/seed-dev-data.ts",
        "helpers/seed-kalakriti-performance.ts",
        "helpers/profile-kalakriti-dashboard.ts",
        "helpers/profile-audit-performance.ts",
        "helpers/profile-kalakriti-audit.ts",
        "helpers/seed-app-performance.ts",
        "shard-by-duration.ts"
      ],
      "ignoreDependencies": ["better-auth"]
    },
    "packages/jobs": {
      "entry": ["src/*.ts", "src/handlers/*.ts", "src/lib/*.ts"]
    },
    "packages/notifications": {
      "entry": ["src/*.ts", "src/send/*.ts"]
    },
    "packages/zero": {
      "entry": ["scripts/verify-kalakriti-operation-integration.ts"]
    },
    "packages/whatsapp": {},
    "packages/email": {},
    "packages/design-system": {
      "ignoreFiles": ["components/**", "hooks/**"],
      "ignoreDependencies": ["@tailwindcss/.*"]
    },
    "packages/editor": {
      "entry": ["src/*.tsx"],
      "ignoreFiles": ["components/**"]
    }
  }
}
